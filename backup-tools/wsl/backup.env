# Configuracao do backup do NovoSGA no WSL2
# Proteja este arquivo com: chmod 600 ~/novosga-backup/backup.env

# Nome do SERVICO no docker-compose.yml/compose.yml.
# Nao coloque aqui o nome fisico do container (ex.: novosga-gabriel-mysqldb-1).
SERVICO_MYSQL="mysqldb"

# Opcional. Deixe vazio normalmente.
# Use apenas se houver MAIS DE UM projeto Compose rodando um servico chamado mysqldb.
COMPOSE_PROJECT=""

USER_MYSQL="novosga"
SENHA_MYSQL="SENHA_DO_MYSQL"
BANCO_MYSQL="novosga2"

# C:\NovoSGA\NovoSGA_Backups no Windows
PASTA_LOCAL="/mnt/c/NovoSGA/NovoSGA_Backups"

# Quantidade maxima de backups locais
MAX_BACKUPS=7
